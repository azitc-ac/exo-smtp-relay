# systemd-Unit für den Betrieb OHNE Docker (Debian/Ubuntu, Raspberry Pi OS).
#
# Einrichten aus dem Release-Archiv (exo-smtp-relay-<version>-linux.tar.gz,
# vorher gegen SHA256SUMS prüfen — README → Releases):
#   sudo useradd -r -s /usr/sbin/nologin -d /opt/exo-smtp-relay exo-relay
#   sudo mkdir -p /opt/exo-smtp-relay
#   sudo tar -xzf exo-smtp-relay-<version>-linux.tar.gz --strip-components=1 -C /opt/exo-smtp-relay
#   sudo python3 -m venv /opt/exo-smtp-relay/venv
#   sudo /opt/exo-smtp-relay/venv/bin/pip install --require-hashes --only-binary :all: -r /opt/exo-smtp-relay/app/requirements.lock
#   (nur Wheels mit den Prüfsummen aus der Lock-Datei; Python 3.11–3.13, x86_64 oder aarch64)
#   sudo mkdir -p /opt/exo-smtp-relay/data && sudo chown -R exo-relay /opt/exo-smtp-relay/data
#   sudo cp /opt/exo-smtp-relay/linux/*.service /opt/exo-smtp-relay/linux/*.path /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now exo-smtp-relay exo-smtp-relay-update.path
#
# Nur data/ gehört dem Dienstkonto; app/ und venv/ bleiben root, der Dienst
# liest sie nur. Aktualisieren über die Weboberfläche (Aktualisierung →
# Einspielen) übernimmt exo-smtp-relay-update.service.
#
# Port 25 ohne root: AmbientCapabilities gibt dem Prozess genau dieses eine
# Recht (deckt auch Port 80 für Let's Encrypt über HTTP-01 ab; dafür
# `sudo apt install certbot` — certbot schreibt nur unter DATA_DIR, das
# ReadWritePaths unten genügt). PowerShell 7 (`pwsh`) für die Postfachabfrage getrennt installieren:
# https://learn.microsoft.com/powershell/scripting/install/install-debian
[Unit]
Description=EXO SMTP Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exo-relay
Group=exo-relay
WorkingDirectory=/opt/exo-smtp-relay/app
Environment=DATA_DIR=/opt/exo-smtp-relay/data
Environment=RELAY_BETRIEBSART=systemd
# Offene Rücknahme des Updaters (data/update/ruecknahme_offen.json) VOR dem Start nachholen —
# derselbe Pfad wie der Windows-Dienst-Wrapper. „+“: als root und ohne ProtectSystem, denn die
# Rücknahme tauscht app/. Blockiert den Start nie: Exit 0, und „-“ ignoriert auch einen Fehlschlag
# (etwa eine ältere Fassung ohne diesen Befehl nach einer Rücknahme).
ExecStartPre=-+/opt/exo-smtp-relay/venv/bin/python /opt/exo-smtp-relay/app/update_tausch.py nachholen --wurzel /opt/exo-smtp-relay --daten /opt/exo-smtp-relay/data
ExecStart=/opt/exo-smtp-relay/venv/bin/python main.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/exo-smtp-relay/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
